# The free desktops' files of the editor (packaging/linux/*.in): the .desktop file, the file types (shared-mime-info)
# and the software centers' metainfo, with their texts in each language of apps/editor/res/lang/*.tsv (the English
# text is the key, as the program's tr() has it). Included by CMakeLists.txt on Linux and the BSDs.

set(STARDRAFT_LANGS ko es ru zh)

# The translation of `english` in `lang` (its .tsv), or "" when it has none.
function(stardraft_tsv_text english lang out)
    string(REGEX REPLACE "([][.*+?^$()|\\\\])" "\\\\\\1" key "${english}")
    file(STRINGS ${CMAKE_SOURCE_DIR}/apps/editor/res/lang/${lang}.tsv found ENCODING UTF-8 REGEX "^${key}\t")
    set(text "")
    if(found)
        list(GET found 0 line)
        string(REGEX REPLACE "^[^\t]*\t([^\r]*).*" "\\1" text "${line}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# The language's code in these files (zh: Simplified Chinese).
function(stardraft_locale lang out)
    if(lang STREQUAL "zh")
        set(${out} zh_CN PARENT_SCOPE)
    else()
        set(${out} ${lang} PARENT_SCOPE)
    endif()
endfunction()

# Lines "<key>[<locale>]=<text>" of a .desktop file, one for each language that has the text.
function(stardraft_desktop_lines key english out)
    set(lines "")
    foreach(lang ${STARDRAFT_LANGS})
        stardraft_tsv_text("${english}" ${lang} t)
        stardraft_locale(${lang} loc)
        if(t)
            string(APPEND lines "${key}[${loc}]=${t}\n")
        endif()
    endforeach()
    string(REGEX REPLACE "\n$" "" lines "${lines}")
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# XML elements "<indent><tag xml:lang="<locale>"><text></tag>", one for each language that has the text.
function(stardraft_xml_lines tag indent english out)
    set(lines "")
    foreach(lang ${STARDRAFT_LANGS})
        stardraft_tsv_text("${english}" ${lang} t)
        stardraft_locale(${lang} loc)
        if(t)
            string(REPLACE "&" "&amp;" t "${t}")
            string(REPLACE "<" "&lt;" t "${t}")
            string(APPEND lines "${indent}<${tag} xml:lang=\"${loc}\">${t}</${tag}>\n")
        endif()
    endforeach()
    string(REGEX REPLACE "\n$" "" lines "${lines}")
    set(${out} "${lines}" PARENT_SCOPE)
endfunction()

# Writes the three files into `dir`: <app id>.desktop, <app id>.xml (the file types), <app id>.metainfo.xml.
function(stardraft_linux_desktop_files dir version)
    set(id io.github.stardraft_editor.StarDraft)
    set(src ${CMAKE_SOURCE_DIR}/packaging/linux)
    stardraft_desktop_lines(GenericName "Map editor" GENERIC_NAMES)
    stardraft_desktop_lines(Comment "Edit StarCraft maps and EUD projects" COMMENTS)
    configure_file(${src}/${id}.desktop.in ${dir}/${id}.desktop @ONLY)
    stardraft_xml_lines(comment "    " "StarCraft map" MAP_COMMENTS)
    stardraft_xml_lines(comment "    " "StarDraft project" PROJECT_COMMENTS)
    stardraft_xml_lines(comment "    " "EUD project" EUD_COMMENTS)
    configure_file(${src}/${id}.xml.in ${dir}/${id}.xml @ONLY)
    stardraft_xml_lines(summary "  " "Edit StarCraft maps and EUD projects" SUMMARIES)
    stardraft_xml_lines(p "    " "Edit the terrain, units, locations and triggers of StarCraft maps. Build EUD maps with euddraft." DESCRIPTIONS)
    stardraft_xml_lines(p "    " "StarDraft 2 is not associated with Blizzard Entertainment." NOTICES)
    stardraft_xml_lines(p "    " "It needs an installation of StarCraft to work." NEEDS)
    string(REGEX MATCH "^[0-9]+(\\.[0-9]+)*" METAINFO_VERSION "${version}")
    if(NOT METAINFO_VERSION)
        set(METAINFO_VERSION 0.0)
    endif()
    string(TIMESTAMP METAINFO_DATE "%Y-%m-%d" UTC)
    configure_file(${src}/${id}.metainfo.xml.in ${dir}/${id}.metainfo.xml @ONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${src}/${id}.desktop.in ${src}/${id}.xml.in ${src}/${id}.metainfo.xml.in)
    foreach(lang ${STARDRAFT_LANGS})
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/apps/editor/res/lang/${lang}.tsv)
    endforeach()
endfunction()
