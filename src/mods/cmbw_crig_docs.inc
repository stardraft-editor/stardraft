// The trigger comment commands' help: from the Cosmonarchy BW "Scenario Setup" page (Fraud's Club,
// https://fraudsclub.com/cosmonarchy-bw/sites/scenario-setup/), its wording, shortened. A command it does not document
// has no entry.
// name ("condition name" for a condition), help
{"condition combat", "Units of the source players fight units of the target players in the area, for the time quota."},
{"condition kills", "The source players' units kill a quota of the target players' units in the area, within the time quota."},
{"condition deaths", "A quota of the players' units die in the area, within the time quota."},
{"condition unit_count", "The players have a quota of these units in the area; \"completed\" counts finished units only."},
{"condition camera", "The player's screen shows the area (with at least the given visibility). Not synced in multiplayer: it may desync."},
{"condition var", "A variable is compared with a value (the operator: ==, !=, <, >, <=, >=; == when left out)."},
{"condition timer", "A timer is compared with a time."},
{"condition unit_color", "The players have a quota of these units of a color in the area."},
{"condition player_race", "The player's race is (==) or is not (!=) terran, protoss or zerg."},
{"condition player_type", "The player is human, computer, witness, human_defeated, computer_defeated or witness_defeated."},
{"condition is_multiplayer", "The game is (true) or is not (false) a multiplayer game."},
{"play_music", "Plays a music file (an imported file: its path with its extension)."},
{"skip_music", "Stops the music."},
{"pause_music", "Pauses the music."},
{"resume_music", "Plays the paused music again."},
{"music_fade_in", "The music fades in over the time."},
{"music_fade_out", "The music fades out over the time."},
{"music_volume", "Sets the volume of custom music (0.0 to 1.0) over the time."},
{"playlist_clear", "Clears the playlist."},
{"playlist_add", "Adds a music file to the playlist."},
{"playlist_shuffle", "Plays the playlist in random order (1) or in order (0)."},
{"set_player_name", "Sets a player's name (with ignore_human_name: also for a human player)."},
{"set_force_name", "Sets the name of the player's force."},
{"recolor", "Changes the screen's colors over the time: blocks of (r g b gamma saturation); one block: all colors, two: shadows and highlights, three: shadows, midtones and highlights, up to 16: a gradient map."},
{"recolor_loop_add", "Adds a recolor (shadows, midtones, highlights) to a loop, for the seconds."},
{"recolor_loop_clear", "Clears the recolor loop."},
{"objective_set", "Sets the text of the objective with this key."},
{"objective_show", "Shows (1) or hides (0) the objective with this key."},
{"objective_score", "Sets the objective's score and its highest score (the score stays within them)."},
{"objective_score_add", "Adds to the objective's score."},
{"objective_score_subtract", "Subtracts from the objective's score."},
{"objective_timer", "Shows a timer at the objective."},
{"objective_remove", "Removes the objective with this key."},
{"objectives_clear", "Removes all objectives."},
{"show_player_layouts", "Shows the AI layouts of the players (green requested, black disabled, brown not yet requesting, white active, purple expanding, yellow locking)."},
{"set_player_unit_name", "Sets the name of a unit type for a player."},
{"set_player_race_name", "Sets the race name that the units show for a player."},
{"unit_sound", "Plays another sound (an imported file) for these units' animation, in place of the old sound (replace) or with it."},
{"play_sound", "Plays a sound file (an imported file: its path with its extension, backslashes only) for the players at the position, when they see it as well as min_visibility (visible, explored, unexplored)."},
{"forbid_replay_auto_upload", "The game does not upload its replay, also in ranked games with more than one human."},
{"set_transmission_waits", "Whether Transmission actions wait. Off: use Wait commands for the waits."},
{"wait", "Waits for the time."},
{"wait_if", "Waits while the condition is true."},
{"wait_until", "Waits until the condition is true."},
{"exit_if", "Stops the trigger's actions when the condition is true."},
{"exit_preserve_if", "Stops the trigger's actions when the condition is true, and keeps the trigger (it runs again)."},
{"show_button", "Shows a button with the name, in the order of its priority. A click sets the variable with its id to 1."},
{"hide_button", "Hides the button with this id."},
{"set_mineral_yields", "Sets the minerals a worker gets from a depleted field and from a field (default 2 and 4)."},
{"set_gas_yields", "Sets the gas a worker gets from a ridge, a geyser and tier 2 and tier 3 gas (default 2, 4, 5 and 6)."},
{"unit_sprite", "Gives these units another sprite (a sprite id or a unit id)."},
{"clear_unit_sprite", "Gives these units their own sprite again (the same values as unit_sprite)."},
{"clear_creep", "Removes the creep in the area."},
{"spawn", "Creates units for the player at the source position, with an effect (None, Augur, AugurDamage, Zerg), after a delay and one after the other (stagger). With a move position, they attack-move there."},
{"layouts_enable", "Turns the AI layouts of these units in the area on or off."},
{"layouts_priority_add", "Adds to the priority of these AI layouts."},
{"layouts_priority_set", "Sets the priority of these AI layouts."},
{"layouts_assign", "Assigns these AI layouts to the resource area at the position (default: the one nearest the area's middle)."},
{"create_town", "Creates a town for the player at the position with workers; it takes the nearest resource area (default) and the layouts in the area."},
{"set_start_location", "Sets the player's start location."},
{"set_race", "Sets the player's race: terran, protoss or zerg."},
{"set_player_color", "Sets the player's color."},
{"kill", "Kills a count of these units in the area; remove: they go without a sound or a corpse."},
{"set_unit_stat", "Changes a stat of a count of these units: armor, range (32 = 1 range), armor_pen, damage, splash_inner, splash_medium, splash_outer, timed_life, heal_range (Clerics), portrait, transport_capacity (at most 64)."},
{"set_unit_behavior", "Turns a behavior of these units on or off: cloak_proximity, cloak_passive, hallucination, disable_passive, critter, no_collision, air_transport, no_energy_overlay, infrastructure_burrow, conquerable."},
{"move_unit", "Moves a count of these units from the area to the destination area; overlay: with the teleport effect."},
{"give_unit", "Gives a count of these units in the area to the target player."},
{"issue_order", "Orders a count of these units to act on the target area and units. For an order that trains, morphs or builds, the last value is the unit made."},
{"rescue_unit", "Gives a count of these units to the target player, with the campaign's rescue sound and picture."},
{"highlight_unit", "Highlights a count of these units (for 45 seconds when no timer is given)."},
{"turn_unit", "Turns a count of these units to the direction."},
{"set_ally_alert_blacklist", "The player gets no alerts from these allies (0 clears the list)."},
{"set_nydus_link", "Links (or unlinks) a Nydus entry to an exit."},
{"var", "Changes a variable: = += -= *= /= %=, toggle or unset; the value: a number, random X Y or $another_variable."},
{"timer", "Changes a timer (the same operators as var)."},
{"bank_link_var", "Links a variable to a bank (saved between games), with a default value (0 when left out)."},
{"bank_clear", "Clears a bank."},
{"convert_to_ai", "The player becomes a computer player."},
{"set_celebration", "Sets the celebration: auto, none, christmas, april_fools."},
{"tyrannize", "These units come under the tyrannizing player's control (tyrant unit: mind_tyrant or demiurge)."},
{"blissful_embrace", "Infests these units (for the infesting player)."},
{"witness_mode", "1: a true witness (not on the score screen); 2: a converted witness (on it)."},
{"set_faction", "Sets the player's faction: orion_imperium, hecaton_coalition, futurist_federation, golden_republic, nydus_trinity, upstart_terran, divine_primacy, order_of_the_sacred_saber, khalendric_knights, starbound, astral_omen, ataltreth, imicren, goszirith, orkoti, zorthos."},
{"set_advisor", "Sets the players' advisor."},
{"neutral_hostile", "Neutral units are hostile (true) or not."},
{"set_player_team_ui", "Turns the player's team display on or off."},
{"set_game_mode_race", "Sets the players' omnipresence: all, terranprotoss, protosszerg, zergterran."},
{"set_player_build_multiplier", "Multiplies the players' build speed (32: as in debug)."},
{"print", "Shows the text."},
{"set_liftoff_disabled", "The players' buildings cannot lift off (true) or can."},
{"set_burrow_disabled", "The players' units cannot burrow (true) or can."},
{"set_burrow_infrastructure_override", "Overrides the burrowing of the players' infrastructure."},
{"disable_tactical_ai", "Turns the players' tactical AI off (true) or on."},
{"disable_extended_waves", "Turns the players' extended attack waves off (true) or on."},
{"set_units_disabled", "The players cannot make these units."},
{"disable_units", "The players cannot make these units (disable), and the buttons are hidden (hide)."},
{"announce_player_defeat", "Announces the player's defeat (with the player's number, by default)."},
{"table_edit", "Changes a value of the unit, weapon or flingy table: table_edit type ids stat operator value. Health counts in 1/256 (+10 is +2560); flags use &; ids, sounds, graphics, weapons and behaviors use =."},
