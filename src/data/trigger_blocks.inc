    {1, "cond.unitdead", "Units", "A unit is dead", "{unit} is dead", "unit|UnitRef|the unit|", "", "", "basic", 1, "({unit}.order == 0)", "CUnit", "Checks if the unit is dying or dead. A dying unit has the order Die (order 0).", "For a unit variable or a unit selected on the map, StarDraft also makes sure that the slot holds the same unit. When a unit dies, the game can give its slot to a new unit.", "hero is dead: the hero in the unit variable died. End the game in defeat for the player."},
    {1, "cond.unitalive", "Units", "A unit is alive", "{unit} is alive", "unit|UnitRef|the unit|", "", "", "basic", 1, "({unit}.order != 0)", "CUnit", "Checks if the unit is alive. The order of a live unit is not Die (order 0).", "For a unit variable or a unit selected on the map, StarDraft also makes sure that the slot holds the same unit. When a unit dies, the game can give its slot to a new unit.", "boss is alive: the boss in the unit variable still lives. Continue the boss attacks."},
    {0, "act.createunitvar", "Units", "Create a unit and keep it", "create {unit} at {where} for {player} and set {var} to it", "unit|UnitType|0|;where|Location|64|;player|Player|P1|;var|UnitTarget||", "", "", "units", 2, "", "CUnit,CreateUnit", "Creates one unit and keeps it in a unit variable. Later blocks can then act on that unit.", "If there is no space to create the unit, the variable holds an empty slot. Before you use the unit, make sure that it is alive.", "create Jim Raynor (Marine) at Start for Player 1 and set hero to it: keep the hero for later triggers."},
    {0, "act.btnreplace", "Game", "Replace a button", "in button set {set}, replace button {index} with {button}", "set|Dat:buttons|7|;index|ButtonIndex|0|;button|Button|1,0,4358864,4338672,0,0,0,0|", "", "", "advanced", 6, "", "wwrite,dwwrite,memcpy", "Replaces a whole button of a set, as on the Buttons tab: its place, icon, when it shows, what it does and its tooltips. A number past the set's last button adds it. Every unit that uses the set has it from now on. To show it on a card that is open now, use Refresh the buttons.", "The first change to a set copies it into the map (room for 32 buttons).", "in button set Terran Barracks, replace button 0 with a new Marine button: the barracks trains a different unit."},
    {0, "act.unitbuttons", "Game", "Give a unit type another button set", "make {unit} show button set {set}", "unit|UnitType|0|;set|Dat:buttons|7|", "", "", "advanced", 4, "", "wwrite,dwwrite,memcpy", "The unit type shows the buttons of another set from now on (its own set is the unit's number).", "", "make Terran Marine show button set Terran Firebat: the marines get the buttons of the firebat."},
    {0, "act.refreshbuttons", "Game", "Refresh the buttons", "refresh the buttons", "", "", "", "advanced", 4, "", "wwrite,dwwrite,memcpy", "Has the game build the command card again, so a change to the buttons shows at once. It makes a Kakaru (Player 12, at Anywhere) for an instant, as EUD Editor 3 does with an Interceptor.", "", "refresh the buttons: show a button change at once on the open command card."},
    {1, "cond.locale", "Players", "The game's language", "this computer's game language is {lang}", "lang|Locale|\"enUS\"|", "", "differs", "basic", 1, "(LocalLocale == {lang})", "LocalLocale", "True when StarCraft runs in that language on this computer.", "Each computer can have another language. Use it only for what that player sees (text, sound), for example in Run local block.", "this computer's game language is Korean: inside Run local block, show the text in Korean."},
    {1, "cond.pname", "Players", "A player's name", "{player}'s name is {text}", "player|Player|P1|;text|Text|Player|", "", "", "basic", 1, "IsPName({player}, {text})", "IsPName", "True when the player has that name (as in the lobby).", "", "Player 1's name is \"Mapmaker\": give the map maker access to test commands."},
    {1, "cond.curplayer", "Players", "Which player is the current player", "the current player is {cmp} {player}", "cmp|NumberComparison|==|;player|PlayerId|P1|", "", "", "basic", 1, "(getcurpl() {cmp} {player})", "getcurpl", "Compares the current player with a player, by player number. Use it inside For each player to do different things for different players. Player 1 is less than Player 2.", "", "the current player is less than Player 5: inside For each player, the players 1 to 4 are one team. Give them 50 minerals."},
    {1, "cond.chat", "Keyboard and mouse", "Chat command", "a player types {text} in the chat", "text|Text|-help|", "", "", "basic", 1, "", "chatEvent", "True in the trigger cycle after a chat line with exactly this text shows on this computer. StarDraft sets up euddraft's chatEvent plugin for it when it builds the map.", "The plugin reads the chat that this computer shows: a line sent only to allies, or to one player, is not seen by every computer. It does not tell who typed it.", "a player types \"-help\" in the chat: show the help text."},
    {1, "cond.trains", "Units", "A unit trains a unit type", "{unit} has {type} in its queue", "unit|UnitRef|the unit|;type|UnitType|Terran Marine|", "", "", "basic", 1, "", "CUnit", "True when the unit trains or builds the unit type, or has it waiting in its queue.", "", "the unit has Terran Marine in its queue: inside For each unit, find the barracks that train marines."},
    {1, "cond.queueempty", "Units", "A unit's build queue is empty", "{unit}'s build queue is empty", "unit|UnitRef|the unit|", "", "", "basic", 1, "{unit}.are_buildq_empty()", "CUnit", "True when the unit trains or builds nothing and has no unit waiting in its queue. Research and upgrades are not in this queue.", "", "the unit's build queue is empty: inside For each unit, find the barracks that do nothing, and give them an order."},
    {2, "val.localplayer", "Players", "This computer's player", "this computer's player (0 to 7)", "", "", "differs", "basic", 1, "getuserplayerid()", "getuserplayerid", "The player who plays on this computer. Player 1 is 0.", "It is another player on each computer. Use it only for what that player sees, for example in Run local block.", "Set me to this computer's player (0 to 7): inside Run local block, show text only for this computer's player."},
    {2, "val.dirx", "Variables", "A point at a direction: x", "the x offset of {d} pixels in direction {a}", "d|Number|64|;a|Number|0|", "", "", "basic", 1, "", "lengthdir_256", "How far to the right a point is that is the distance away in the direction. The direction is 0 to 255, as the game counts directions: 0 is up and 64 is right. Add it to an x.", "", "Set x to x + the x offset of 64 pixels in direction dir: put a location 2 tiles in front of the hero."},
    {2, "val.diry", "Variables", "A point at a direction: y", "the y offset of {d} pixels in direction {a}", "d|Number|64|;a|Number|0|", "", "", "basic", 1, "", "lengthdir_256", "How far down a point is that is the distance away in the direction. The direction is 0 to 255: 0 is up and 128 is down. Add it to a y.", "", "Set y to y + the y offset of 64 pixels in direction dir: put a location 2 tiles in front of the hero."},
    {2, "val.groupsize", "Units", "Units in a group", "how many units {group} has", "group|UnitGroupTarget||", "", "", "hidden", 1, "", "", "How many units are in the unit group now. A unit that died leaves it the next time For each unit in the group goes through it.", "", "Set left to how many units guards has: count the guards in the group."},
