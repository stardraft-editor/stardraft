    {0, "act.unitremove", "Units", "Remove this unit", "remove {unit}", "unit|UnitRef|the unit|", "", "", "basic", 1, "{unit}.remove()", "CUnit", "Removes one unit from the game without a death: no death animation, no sound, and no death counted.", "", "remove the unit: inside For each unit, remove each unit that leaves the map through the exit."},
