    {0, "act.prop.flingy", "Game", "Change a flingy's movement", "change flingy {flingy}'s {prop}: {mod} {value}", "flingy|Dat:flingy|0|;prop|Property:Flingy|topSpeed|;mod|VarModifier|SetTo|;value|ValueOf:prop|1280|", "", "", "advanced", 2, "@prop Flingy", "Flingy", "Changes movement values from flingy.dat. Units and projectiles move with a flingy. Examples are top speed, acceleration, and turning.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change flingy Zergling's top speed: set to 1280: change the speed of all zerglings for the rest of the game."},
    {1, "cond.prop.flingy", "Game", "Check a flingy's movement", "flingy {flingy}'s {prop} is {cmp} {value}", "flingy|Dat:flingy|0|;prop|Property:Flingy|topSpeed|;cmp|NumberComparison|==|;value|ValueOf:prop|1280|", "", "", "advanced", 2, "@prop Flingy", "Flingy", "Compares one movement value from flingy.dat. Units and projectiles move with a flingy. Examples are top speed, acceleration, and turning.", "It reads the current value in the game. This value includes changes from triggers.", "flingy Zergling's top speed is exactly 1280: find if another trigger changed the speed."},
    {0, "act.prop.sprite", "Game", "Change a sprite's settings", "change sprite {sprite}'s {prop}: {mod} {value}", "sprite|Dat:sprites|0|;prop|Property:Sprite|isVisible|;mod|VarModifier|SetTo|;value|ValueOf:prop|1|", "", "", "advanced", 2, "@prop Sprite", "Sprite", "Changes the values of a sprite from sprites.dat.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change sprite Scanner Sweep's visibility: set to 1: show a sprite that a trigger hid before."},
    {1, "cond.prop.sprite", "Game", "Check a sprite's settings", "sprite {sprite}'s {prop} is {cmp} {value}", "sprite|Dat:sprites|0|;prop|Property:Sprite|isVisible|;cmp|NumberComparison|==|;value|ValueOf:prop|1|", "", "", "advanced", 2, "@prop Sprite", "Sprite", "Compares one value of a sprite from sprites.dat.", "It reads the current value in the game. This value includes changes from triggers.", "sprite Scanner Sweep's visibility is exactly 1: check that the sprite shows."},
    {0, "act.prop.image", "Game", "Change an image's settings", "change image {image}'s {prop}: {mod} {value}", "image|Dat:images|0|;prop|Property:Image|drawIfCloaked|;mod|VarModifier|SetTo|;value|ValueOf:prop|1|", "", "", "advanced", 2, "@prop Image", "Image", "Changes the values of an image from images.dat. Examples are values for turning, clicking, and drawing.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change image Marine's draw if cloaked: set to 1: the image shows also when the unit is cloaked."},
