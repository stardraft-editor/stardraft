    {0, "act.srand", "Variables", "Set the random seed", "set the random seed to {n}", "n|Number|0|", "", "", "advanced", 1, "srand({n})", "srand", "Starts the random numbers again from a number: the same seed gives the same random numbers.", "", "set the random seed to 42: the random numbers are the same in each game, for a test."},
