    {0, "act.local", "Logic and flow", "Run local block", "run local block", "", "Do|action", "local", "basic", 1, "", "IsUserCP", "Runs its actions only on the current player's own computer. Use it for what only that player sees or hears, such as text, sounds, the camera or the screen. In For each player, it runs for each player on their own computer.", "Never change the game in it (units, resources, locations, switches, deaths, random numbers, Wait): the other computers do not do it, and the game desyncs. Variables changed in it differ from computer to computer: use them only for what the player sees.", "run local block, with Play a sound inside: play a sound that only the current player hears."},
    {0, "act.donothing", "Logic and flow", "Do nothing", "do nothing", "", "", "", "basic", 0, "", "", "A placeholder that does nothing. When you add an action, the action replaces the placeholder.", "", "do nothing: a placeholder in a new trigger. Replace it with an action."},
    {0, "act.comment", "Logic and flow", "Comment", "note: {text}", "text|Text||", "", "", "basic", 0, "", "", "A note for the persons who read the trigger. It does nothing in the game.", "", "note: \"This trigger starts wave 2\": tell other map makers what the trigger does."},
    {0, "act.victory", "Game", "Victory", "end the game in victory for {who}", "who|PlayerGroup|CurrentPlayer|", "", "cp", "basic", 1, "Victory()", "Victory", "Ends the game in victory for a player. The default is the current player: inside For each player, each player in turn. You can also select Player 1 to Player 8, all players, or a force.", "", "end the game in victory for the current player: the player killed the boss."},
    {0, "act.defeat", "Game", "Defeat", "end the game in defeat for {who}", "who|PlayerGroup|CurrentPlayer|", "", "cp", "basic", 1, "Defeat()", "Defeat", "Ends the game in defeat for a player. The default is the current player: inside For each player, each player in turn. You can also select Player 1 to Player 8, all players, or a force.", "", "end the game in defeat for the current player: the player lost the hero."},
    {0, "act.draw", "Game", "Draw", "end the game in a draw for all players", "", "", "", "basic", 1, "Draw()", "Draw", "Ends the game in a draw for all players.", "", "end the game in a draw: the time is over and no player won."},
    {0, "act.pausegame", "Game", "Pause the game", "pause the game", "", "", "", "basic", 1, "PauseGame()", "PauseGame", "Pauses the game (single player only).", "", "pause the game: stop the game in a single player map while the player reads a long text."},
    {0, "act.unpausegame", "Game", "Resume the game", "resume the game", "", "", "", "basic", 1, "UnpauseGame()", "UnpauseGame", "Continues a paused game.", "", "resume the game: continue the single player map after the text."},
    {0, "act.setmemory", "Game", "Change memory", "{mod} {n} at memory {addr}", "mod|Modifier|SetTo|;n|Number|0|;addr|Address|0x58A364|", "", "memory", "advanced", 1, "SetMemory({addr}, {mod}, {n})", "SetMemory", "Writes a 4-byte value into StarCraft's memory.", "If Remastered does not permit an address, the game ends. A wrong value can crash the game. Use the typed blocks where possible.", "set to 0 at memory 0x58A364: write a game value that no block changes. Use this only when you know the address."},
