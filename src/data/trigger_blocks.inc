    {0, "act.locmouse", "Keyboard and mouse", "Move a location to the mouse", "move {where} to {player}'s mouse", "where|Location|1|;player|Player|CurrentPlayer|", "", "", "basic", 3, "setloc({where}, msqc_MouseXNow[msqc_player({player})] - (dwread(0x58DC60 + 20 * ({where} - 1) + 8) - dwread(0x58DC60 + 20 * ({where} - 1))) / 2, msqc_MouseYNow[msqc_player({player})] - (dwread(0x58DC60 + 20 * ({where} - 1) + 12) - dwread(0x58DC60 + 20 * ({where} - 1) + 4)) / 2, msqc_MouseXNow[msqc_player({player})] + (dwread(0x58DC60 + 20 * ({where} - 1) + 8) - dwread(0x58DC60 + 20 * ({where} - 1))) / 2, msqc_MouseYNow[msqc_player({player})] + (dwread(0x58DC60 + 20 * ({where} - 1) + 12) - dwread(0x58DC60 + 20 * ({where} - 1) + 4)) / 2)", "setloc,dwread", "Centers the location on the player's mouse; the location keeps its size. It uses the MSQC plugin, as Mouse X does.", "The place reaches the triggers one trigger cycle after the mouse moves. Before the player moves the mouse, the place is 0, 0.", "move Cursor to the current player's mouse: create a unit where the player points the mouse."},
    {0, "act.addloc", "Units", "Shift a location", "shift {where} by x {x}, y {y}", "where|Location|1|;x|Number|32|;y|Number|0|", "", "", "basic", 1, "addloc({where}, {x}, {y})", "addloc", "Moves a location by a number of pixels. A negative value moves it left or up.", "", "shift Bullet by x 32, y 0: move the location one tile to the right in each trigger cycle."},
    {0, "act.upgrade", "Players", "Set a player's upgrade level", "{mod} {n} levels of {upgrade} for {player}", "mod|VarModifier|SetTo|;n|Number|1|0..255;upgrade|Dat:upgrades|0|;player|PlayerId|getcurpl()|", "", "", "basic", 1, "", "bread,bwrite", "Sets the level of an upgrade for a player, as if the player researched it. Examples are armor, weapons and speed.", "Do not set a level above the maximum level of the upgrade. The game is not made for higher levels.", "set to 3 levels of Terran Infantry Weapons for Player 1: give the player full weapons at the start."},
    {0, "act.tech", "Players", "Set a technology researched", "make {tech} {state} for {player}", "tech|Dat:techdata|0|;state|Researched|1|;player|PlayerId|getcurpl()|", "", "", "basic", 1, "", "bwrite", "Gives a technology to a player or takes it away, as if the player researched it. Examples are stim packs and lockdown.", "", "make Stim Packs researched for Player 1: the player can use stim packs at the start."},
    {0, "act.prop.player", "Players", "Change a player's property", "change {player}'s {prop}: {mod} {value}", "player|PlayerId|getcurpl()|;prop|Property:TrgPlayer|mineral|;mod|VarModifier|Add|;value|ValueOf:prop|50|", "", "", "basic", 1, "@prop TrgPlayer", "TrgPlayer", "Changes one value of a player. Examples are minerals, gas, supply (as players see it), the supply limit, scores, and colors.", "", "change Player 1's minerals: add 50: give the player a reward for each kill."},
    {1, "cond.upgrade", "Players", "A player's upgrade level", "{player}'s level of {upgrade} is {cmp} {n}", "player|PlayerId|getcurpl()|;upgrade|Dat:upgrades|0|;cmp|NumberComparison|>=|;n|Number|1|", "", "", "basic", 1, "", "bread", "Compares a player's level of an upgrade.", "", "Player 1's level of Terran Infantry Weapons is at least 1: the player researched the first level. Show the next goal."},
    {1, "cond.tech", "Players", "A technology is researched", "{player} has {tech}", "player|PlayerId|getcurpl()|;tech|Dat:techdata|0|", "", "", "basic", 1, "", "bread", "Checks if a player has researched a technology.", "", "Player 1 has Stim Packs: the player researched stim packs. Show a hint about stim packs."},
    {1, "cond.prop.player", "Players", "Check a player's property", "{player}'s {prop} is {cmp} {value}", "player|PlayerId|getcurpl()|;prop|Property:TrgPlayer|mineral|;cmp|NumberComparison|>=|;value|ValueOf:prop|100|", "", "", "basic", 1, "@prop TrgPlayer", "TrgPlayer", "Compares one value of a player. Examples are minerals, gas, supply, and scores.", "", "Player 1's minerals is at least 100: the player has enough minerals to buy a unit."},
    {1, "cond.keydown", "Keyboard and mouse", "Key pressed", "{player} presses {key}", "player|Player|CurrentPlayer|;key|Key|Q|", "", "", "basic", 1, "msqc_KeyDown_{key}[msqc_player({player})] >= 1", "", "True in the trigger cycle after the player presses the key. The key does not count while the player types in the chat. StarDraft adds euddraft's MSQC plugin to the built map. The plugin sends the key to every player, so all players see the same.", "Each key or button that triggers read is sent over the network for every human player: use the ones the map needs. What a player does reaches the triggers one trigger cycle later.", "the current player presses Q: the player uses the hero's special attack."},
    {1, "cond.keyup", "Keyboard and mouse", "Key released", "{player} releases {key}", "player|Player|CurrentPlayer|;key|Key|Q|", "", "", "basic", 1, "msqc_KeyUp_{key}[msqc_player({player})] >= 1", "", "True in the trigger cycle after the player releases the key. The key does not count while the player types in the chat. It uses the MSQC plugin, as Key pressed does.", "Each key or button that triggers read is sent over the network for every human player: use the ones the map needs. What a player does reaches the triggers one trigger cycle later.", "the current player releases Q: fire the charged attack of the hero now."},
    {1, "cond.keyheld", "Keyboard and mouse", "Key held", "{player} holds {key} down", "player|Player|CurrentPlayer|;key|Key|Q|", "", "", "basic", 1, "msqc_KeyPress_{key}[msqc_player({player})] >= 1", "", "True in each trigger cycle while the player holds the key down. The key does not count while the player types in the chat. It uses the MSQC plugin, as Key pressed does.", "Each key or button that triggers read is sent over the network for every human player: use the ones the map needs. What a player does reaches the triggers one trigger cycle later.", "the current player holds W down: the hero moves up while the player holds the key."},
    {1, "cond.mousedown", "Keyboard and mouse", "Mouse button pressed", "{player} presses the {button} mouse button", "player|Player|CurrentPlayer|;button|MouseButton|L|", "", "", "basic", 1, "msqc_MouseDown_{button}[msqc_player({player})] >= 1", "", "True in the trigger cycle after the player presses the mouse button. It uses the MSQC plugin, as Key pressed does.", "Each key or button that triggers read is sent over the network for every human player: use the ones the map needs. What a player does reaches the triggers one trigger cycle later.", "the current player presses the left mouse button: the player shoots at the mouse."},
    {1, "cond.mouseup", "Keyboard and mouse", "Mouse button released", "{player} releases the {button} mouse button", "player|Player|CurrentPlayer|;button|MouseButton|L|", "", "", "basic", 1, "msqc_MouseUp_{button}[msqc_player({player})] >= 1", "", "True in the trigger cycle after the player releases the mouse button. It uses the MSQC plugin, as Key pressed does.", "Each key or button that triggers read is sent over the network for every human player: use the ones the map needs. What a player does reaches the triggers one trigger cycle later.", "the current player releases the left mouse button: stop the fire of the hero."},
    {1, "cond.mouseheld", "Keyboard and mouse", "Mouse button held", "{player} holds the {button} mouse button down", "player|Player|CurrentPlayer|;button|MouseButton|L|", "", "", "basic", 1, "msqc_MousePress_{button}[msqc_player({player})] >= 1", "", "True in each trigger cycle while the player holds the mouse button down. It uses the MSQC plugin, as Key pressed does.", "Each key or button that triggers read is sent over the network for every human player: use the ones the map needs. What a player does reaches the triggers one trigger cycle later.", "the current player holds the left mouse button down: the hero fires each trigger cycle while the button is down."},
    {1, "cond.mousein", "Keyboard and mouse", "Mouse in location", "{player}'s mouse is in {where}", "player|Player|CurrentPlayer|;where|Location|1|", "", "", "basic", 4, "(msqc_MouseXNow[msqc_player({player})] >= dwread(0x58DC60 + 20 * ({where} - 1)) && msqc_MouseXNow[msqc_player({player})] <= dwread(0x58DC60 + 20 * ({where} - 1) + 8) && msqc_MouseYNow[msqc_player({player})] >= dwread(0x58DC60 + 20 * ({where} - 1) + 4) && msqc_MouseYNow[msqc_player({player})] <= dwread(0x58DC60 + 20 * ({where} - 1) + 12))", "dwread", "True while the player's mouse is on the location's area of the map (the location as it is now: moved locations count where they are). It uses the MSQC plugin, as Mouse X does.", "The place reaches the triggers one trigger cycle after the mouse moves. Before the player moves the mouse, the place is 0, 0.", "the current player's mouse is in Shop button: the player points at the shop. Show the price of the item."},
    {1, "cond.mousenear", "Keyboard and mouse", "Mouse near a unit", "{player}'s mouse is within {d} pixels of {unit}", "player|Player|CurrentPlayer|;d|Number|64|;unit|UnitRef|the unit|", "", "", "basic", 6, "(sqrt((msqc_MouseXNow[msqc_player({player})] - {unit}.posX) * (msqc_MouseXNow[msqc_player({player})] - {unit}.posX) + (msqc_MouseYNow[msqc_player({player})] - {unit}.posY) * (msqc_MouseYNow[msqc_player({player})] - {unit}.posY)) <= {d})", "sqrt", "True while the player's mouse is at most that many pixels from the unit's center. It uses the MSQC plugin, as Mouse X does.", "The place reaches the triggers one trigger cycle after the mouse moves. Before the player moves the mouse, the place is 0, 0. The distance is to the unit's center, not to its edge.", "the current player's mouse is within 64 pixels of the unit: the player points at the unit. Show its name."},
    {1, "cond.unitin", "Units", "A unit is in a location", "{unit} is in {where}", "unit|UnitRef|the unit|;where|Location|64|", "", "", "basic", 1, "", "dwread", "Checks if the position of one unit is inside a location.", "It uses the center point of the unit.", "the unit is in Lava: inside For each unit, find the units in the lava. Kill them."},
    {2, "val.prop.player", "Players", "A player's property", "{player}'s {prop}", "player|PlayerId|getcurpl()|;prop|Property:TrgPlayer|mineral|", "", "", "basic", 1, "@prop TrgPlayer", "TrgPlayer", "One value of a player. Examples are minerals, supply, and scores.", "", "Set supply to Player 1's supply used (Terran): keep the supply of the player to show it in a text."},
    {2, "val.upgrade", "Players", "A player's upgrade level", "{player}'s level of {upgrade}", "player|PlayerId|getcurpl()|;upgrade|Dat:upgrades|0|", "", "", "basic", 1, "", "bread", "A player's level of an upgrade.", "", "Set level to Player 1's level of Terran Infantry Weapons: show the weapon level in a text."},
    {2, "val.unitcount", "Players", "Units a player has", "how many {unit} {player} has, unfinished too", "unit|UnitType|0|;player|PlayerId|getcurpl()|", "", "", "basic", 1, "", "dwread_epd", "All the units of a type that a player has, including units that are still in construction or in training.", "", "Set marines to how many Terran Marine Player 1 has, unfinished too: count the marines in training too."},
    {2, "val.kills", "Players", "Kills of a unit type", "kills of {unit} by {player}", "unit|UnitType|0|;player|PlayerId|getcurpl()|", "", "", "basic", 1, "", "dwread_epd", "How many of a unit type a player has killed.", "", "Set score to kills of Zerg Zergling by Player 1: show how many zerglings the player killed."},
    {2, "val.mousex", "Keyboard and mouse", "Mouse X", "{player}'s mouse x on the map", "player|PlayerId|getcurpl()|", "", "", "basic", 1, "msqc_MouseXNow[{player}]", "", "Where the player's mouse is on the map, in pixels: left to right. StarDraft adds euddraft's MSQC plugin to the built map. The plugin sends the place to every player when the mouse moves. Before the player moves the mouse, the value is 0.", "The place reaches the triggers one trigger cycle after the mouse moves. Each move is sent over the network.", "Set x to the current player's mouse x on the map: move a location to the mouse with this x."},
    {2, "val.mousey", "Keyboard and mouse", "Mouse Y", "{player}'s mouse y on the map", "player|PlayerId|getcurpl()|", "", "", "basic", 1, "msqc_MouseYNow[{player}]", "", "Where the player's mouse is on the map, in pixels: top to bottom. It uses the MSQC plugin, as Mouse X does. Before the player moves the mouse, the value is 0.", "The place reaches the triggers one trigger cycle after the mouse moves. Each move is sent over the network.", "Set y to the current player's mouse y on the map: move a location to the mouse with this y."},
    {1, "cond.herekey", "Keyboard and mouse", "Key held on this computer", "this computer's player holds {key} down", "key|Key|TAB|", "", "differs", "basic", 1, "msqc_Here_{key}() == 1", "", "True while the player on this computer holds the key down. Nothing is sent over the network. The key does not count while the player types in the chat.", "It is true only on that player's computer. Use it only for what that player sees or hears, for example in Run local block. To change the game with a key, use \"presses\" or \"holds down\" with a player.", "In Run local block: this computer's player holds TAB down: show the help text on this screen only."},
    {1, "cond.heremouse", "Keyboard and mouse", "Mouse button held on this computer", "this computer's player holds the {button} mouse button down", "button|MouseButton|L|", "", "differs", "basic", 1, "msqc_HereMouse_{button}() == 1", "", "True while the player on this computer holds the mouse button down. Nothing is sent over the network.", "It is true only on that player's computer. Use it only for what that player sees or hears, for example in Run local block.", "In Run local block: this computer's player holds the right mouse button down: show the range circle on this screen only."},
    {2, "val.screenx", "Keyboard and mouse", "Screen X on this computer", "this computer's screen x on the map", "", "", "differs", "basic", 1, "dwread_epd(EPD(0x62848C))", "dwread_epd,EPD", "Where the left edge of the map view is on this computer, in pixels from the left edge of the map.", "Each computer has its own value. Use it only for what that player sees, for example in Run local block. To send it to every computer, use \"Share a local value\".", "In Run local block: if the screen x is less than 640, show \"You are in the west\" on this screen."},
    {2, "val.screeny", "Keyboard and mouse", "Screen Y on this computer", "this computer's screen y on the map", "", "", "differs", "basic", 1, "dwread_epd(EPD(0x6284A8))", "dwread_epd,EPD", "Where the top edge of the map view is on this computer, in pixels from the top edge of the map.", "Each computer has its own value. Use it only for what that player sees, for example in Run local block. To send it to every computer, use \"Share a local value\".", "In Run local block: if the screen y is less than 480, show \"You are in the north\" on this screen."},
    {2, "val.heremousex", "Keyboard and mouse", "Mouse X on this computer", "this computer's mouse x on the map", "", "", "differs", "basic", 1, "(dwread_epd(EPD(0x62848C)) + dwread_epd(EPD(0x6CDDC4)))", "dwread_epd,EPD", "Where the mouse of this computer's player is on the map, in pixels: left to right. Nothing is sent over the network, and the value has no delay.", "Each computer has its own value. Use it only for what that player sees, for example in Run local block. For a value that is the same on each computer, use \"{player}'s mouse x on the map\".", "In Run local block: move the cursor sprite to this computer's mouse x on the map (a picture on this screen only)."},
    {2, "val.heremousey", "Keyboard and mouse", "Mouse Y on this computer", "this computer's mouse y on the map", "", "", "differs", "basic", 1, "(dwread_epd(EPD(0x6284A8)) + dwread_epd(EPD(0x6CDDC8)))", "dwread_epd,EPD", "Where the mouse of this computer's player is on the map, in pixels: top to bottom. Nothing is sent over the network, and the value has no delay.", "Each computer has its own value. Use it only for what that player sees, for example in Run local block. For a value that is the same on each computer, use \"{player}'s mouse y on the map\".", "In Run local block: move the cursor sprite to this computer's mouse y on the map (a picture on this screen only)."},
    {2, "val.locx", "Units", "A location's center x", "the center x of {where}", "where|Location|1|", "", "", "basic", 1, "", "dwread", "The x coordinate of the center of a location, in pixels.", "", "Set x to the center x of Hero: keep the x of the hero's location for a calculation."},
    {2, "val.locy", "Units", "A location's center y", "the center y of {where}", "where|Location|1|", "", "", "basic", 1, "", "dwread", "The y coordinate of the center of a location, in pixels.", "", "Set y to the center y of Hero: keep the y of the hero's location for a calculation."},
    {2, "val.distance", "Units", "Distance between two units", "the distance from {a} to {b}", "a|UnitRef|the unit|;b|UnitRef|the unit|", "", "", "basic", 1, "", "sqrt", "The distance between two units, in pixels. One tile is 32 pixels.", "The maximum is about 65,000 pixels. This is sufficient for all maps.", "Set range to the distance from hero to the unit: inside For each unit, find how far each enemy is from the hero."},
    {0, "act.killall", "Units", "Kill all of a unit type", "kill all {unit} of {player}", "unit|UnitFilter|229|;player|PlayerGroup|P8|", "", "", "basic", 1, "KillUnit({unit}, {player})", "KillUnit", "Kills every unit of a type a player owns, anywhere on the map.", "", "kill all Zerg Zergling of Player 8: kill the remaining enemies when the wave ends."},
    {0, "act.removeall", "Units", "Remove all of a unit type", "remove all {unit} of {player}", "unit|UnitFilter|229|;player|PlayerGroup|P8|", "", "", "basic", 1, "RemoveUnit({unit}, {player})", "RemoveUnit", "Removes all the units of a type that a player owns, with no death and no score.", "", "remove all Terran Civilian of Player 1: remove the civilians at the end of a round with no death."},
    {0, "act.printat", "Text and screen", "Show values on a line", "show {text} with {a} and {b} on line {line} to {to}", "text|Text|Gold: {} Wave: {}|;a|Number|0|;b|Number|0|;line|Number|0|0..10;to|DisplayTo|all|", "", "local", "replaced", 1, "", "printAt,printAllAt", "Shows text with numbers on one of the 11 message lines. Each {} in the text is replaced by a value.", "", "show \"Gold: {} Wave: {}\" with gold and wave on line 0 to all players: show the two values on the top line."},
    {0, "act.eprint", "Text and screen", "Show a message in the middle", "show {text} in the middle of the screen to {to}", "text|Text|Not enough minerals|;to|DisplayTo|all|", "", "local", "replaced", 1, "", "eprintln,eprintAll", "Shows text in the area for error messages, above the console.", "", "show \"Not enough gold\" in the middle of the screen to the current player: tell the player that the purchase did not go through."},
    {0, "act.eprintf", "Text and screen", "Show text with values in the middle of the screen", "show {text} with {a} and {b} in the middle of the screen to {to}", "text|Text|Kills: {} Wave: {}|;a|Number|0|;b|Number|0|;to|DisplayTo|all|", "", "local", "replaced", 1, "", "f_eprintf,f_eprintAll", "Shows text in the area for error messages, above the console. Each {} in the text is replaced by a value, in sequence.", "Use at most two {} in the text. A value that has no {} is not shown.", "show \"Kills: {} Wave: {}\" with kills and wave in the middle of the screen to all players: show the values in the center."},
    {0, "act.unitclearq", "Units", "Clear a unit's build queue", "clear {unit}'s build queue", "unit|UnitRef|the unit|", "", "", "basic", 1, "{unit}.reset_buildq()", "CUnit", "Removes the units that wait in the build queue of a building or a unit. Research and upgrades are not in this queue.", "Use it only when nothing is being built (the queue is not empty, but the unit does not train now). The unit that is being built is not stopped correctly, and the game does not give back the minerals and gas of the removed units.", "clear the unit's build queue: inside For each unit, stop each Terran Barracks of the player from training."},
    {0, "act.runtrigger", "Logic and flow", "Run a trigger", "run {trigger}", "trigger|TriggerRef||", "", "", "basic", 1, "", "", "Runs a trigger from Definitions now. If its conditions are true, its actions run. Use it to share actions between triggers.", "Triggers in Definitions run only from this block. A trigger that runs itself never ends, and StarDraft shows this as an error.", "run Reward: run the actions of the Reward trigger from different triggers. Write the actions one time only."},
    {0, "act.stop", "Logic and flow", "Stop this trigger", "stop this trigger here", "", "", "", "basic", 1, "", "", "Skips the rest of this trigger for this run. The trigger runs again the next time, as usual.", "", "stop this trigger here: inside an If, skip the rest of the trigger when the player has no gold."},
    {0, "act.break", "Logic and flow", "Leave the loop", "leave the loop", "", "", "", "basic", 1, "", "", "Leaves the innermost loop (Repeat, While or For each) immediately. The blocks after the loop run as usual.", "", "leave the loop: inside For each unit, stop at the first Terran Ghost. The blocks after the loop then run."},
    {0, "act.setdeathsx", "Game", "Set deaths (bits)", "{mod} {n} deaths of {unit} for {player}, bits {mask}", "mod|Modifier|SetTo|;n|Number|1|;unit|UnitType|0|;player|PlayerGroup|P1|;mask|Number|0xFF|", "", "", "advanced", 1, "SetDeathsX({player}, {mod}, {n}, {unit}, {mask})", "SetDeathsX", "Changes only the bits of a death counter that are in the mask. Thus, several values can share one counter.", "Give the value at the position of the masked bits. For example, 0x100 is 1 in the second byte.", "set to 0x100 deaths of Unused Terran Bldg 1 for Player 1, bits 0xFF00: keep a value in the second byte of a counter."},
    {0, "act.setmemoryx", "Game", "Set memory (bits)", "{mod} {n} at memory {addr}, bits {mask}", "mod|Modifier|SetTo|;n|Number|0|;addr|Address|0x58A364|;mask|Number|0xFFFFFFFF|", "", "memory", "advanced", 1, "SetMemoryX({addr}, {mod}, {n}, {mask})", "SetMemoryX", "Changes only the bits in the mask, in the 4 bytes at an address.", "Remastered permits only some addresses. A wrong address crashes the game.", "set to 0 at memory 0x58A364, bits 0xFF: change only the first byte of a game value. Use this only when you know the address."},
    {1, "cond.chance", "Logic and flow", "A random chance", "with a {pct}% chance", "pct|Percent|50|0..100", "", "", "basic", 1, "(rand() % 100 < {pct})", "rand", "This condition is true this many times in 100, at random. The result is the same for all players.", "", "with a 25% chance: the enemy drops a reward one time in four kills."},
    {1, "cond.near", "Units", "Two units are near", "{a} is within {d} pixels of {b}", "a|UnitRef|the unit|;d|Number|128|;b|UnitRef|the unit|", "", "", "basic", 1, "(sqrt(({a}.posX - {b}.posX) * ({a}.posX - {b}.posX) + ({a}.posY - {b}.posY) * ({a}.posY - {b}.posY)) <= {d})", "sqrt", "Checks if two units are this distance apart or less. One tile is 32 pixels.", "", "hero is within 128 pixels of the unit: inside For each unit, find the enemies near the hero."},
    {1, "cond.deathsx", "Game", "Deaths (bits)", "{player} has {cmp} {n} deaths of {unit} in bits {mask}", "player|PlayerGroup|P1|;cmp|Comparison|AtLeast|;n|Number|1|;unit|UnitType|0|;mask|Number|0xFF|", "", "", "advanced", 1, "DeathsX({player}, {cmp}, {n}, {unit}, {mask})", "DeathsX", "Compares only the bits of a death counter that are in the mask.", "", "Player 1 has exactly 0x100 deaths of Unused Terran Bldg 1 in bits 0xFF00: check a value in the second byte of a counter."},
    {1, "cond.memoryx", "Game", "Memory (bits)", "memory at {addr} is {cmp} {n} in bits {mask}", "addr|Address|0x58A364|;cmp|Comparison|Exactly|;n|Number|0|;mask|Number|0xFFFFFFFF|", "", "memory", "advanced", 1, "MemoryX({addr}, {cmp}, {n}, {mask})", "MemoryX", "Compares only the bits in the mask, in the 4 bytes at an address.", "", "memory at 0x58A364 is exactly 0 in bits 0xFF: compare only the first byte of a game value."},
    {2, "val.max", "Variables", "The larger of two", "the larger of {a} and {b}", "a|Number|0|;b|Number|0|", "", "", "basic", 1, "", "", "The larger of the two numbers.", "", "Set damage to the larger of damage and 1: the damage is always at least 1."},
    {2, "val.min", "Variables", "The smaller of two", "the smaller of {a} and {b}", "a|Number|0|;b|Number|0|", "", "", "basic", 1, "", "", "The smaller of the two numbers.", "", "Set hp to the smaller of hp + 20 and 100: heal the hero, but not above 100."},
    {2, "val.sqrt", "Variables", "A square root", "the square root of {a}", "a|Number|0|", "", "", "basic", 1, "sqrt({a})", "sqrt", "The square root, rounded down.", "", "Set range to the square root of dx * dx + dy * dy: calculate the distance between two points."},
    {2, "val.angle", "Units", "Direction between two units", "the direction from {a} to {b}", "a|UnitRef|the unit|;b|UnitRef|the unit|", "", "", "basic", 1, "atan2_256({b}.posX - {a}.posX, {b}.posY - {a}.posY)", "atan2_256", "The direction from one unit to another unit, as StarCraft counts it. The range is 0 to 255, and 0 is up.", "", "Set dir to the direction from hero to the unit: keep the direction to the enemy for a missile."},
    {2, "val.memory", "Game", "A number in memory", "the number at memory {addr}", "addr|Address|0x58A364|", "", "memory", "advanced", 1, "dwread({addr})", "dwread", "The 4 bytes at an address, as a number.", "", "Set value to the number at memory 0x58A364: read a game value that no block reads."},
