    {0, "act.groupadd", "Units", "Add a unit to a group", "add {unit} to {group}", "unit|UnitRef|the unit|;group|UnitGroupTarget||", "", "", "hidden", 4, "", "EUDArray", "Adds a unit to a unit group, to go through later with For each unit in the group. A full group, or a unit that is in it already, stays as it is.", "", "add the unit to guards: inside For each new unit, put each new marine in the guards group."},
    {0, "act.qgc.rightclick", "Keyboard and mouse", "Right-click as a player", "make {player} right-click at x {x}, y {y}", "player|PlayerId|P1|;x|Number|0|;y|Number|0|", "", "", "advanced", 1, "", "QueueGameCommand_RightClick", "Sends a right-click on the map at the place, from the player's computer. The command goes from that player's computer to every computer, as if the player gave it, so the game stays the same everywhere. It acts on what the player has selected.", "", "make Player 1 right-click at x 1024, y 512: the selected units of the player move to that point."},
    {0, "act.qgc.select", "Keyboard and mouse", "Select a unit as a player", "make {player} select {unit}", "player|PlayerId|P1|;unit|UnitRef|the unit|", "", "", "advanced", 1, "", "QueueGameCommand_Select", "Selects one unit for the player, as if the player clicked it. The command goes from that player's computer to every computer, as if the player gave it, so the game stays the same everywhere. It acts on what the player has selected.", "", "make Player 1 select hero: the player starts the game with the hero selected."},
    {0, "act.qgc.train", "Keyboard and mouse", "Train as a player", "make {player} train {unit}", "player|PlayerId|P1|;unit|UnitType|Terran Marine|", "", "", "advanced", 1, "", "QueueGameCommand_TrainUnit", "Starts training the unit type in the selected building, as if the player clicked its button. The command goes from that player's computer to every computer, as if the player gave it, so the game stays the same everywhere. It acts on what the player has selected.", "", "make Player 1 train Terran Marine: the selected barracks of the player starts to train a marine."},
    {0, "act.qgc.ping", "Keyboard and mouse", "Ping the minimap as a player", "make {player} ping the minimap at x {x}, y {y}", "player|PlayerId|P1|;x|Number|0|;y|Number|0|", "", "", "advanced", 1, "", "QueueGameCommand_MinimapPing", "Pings the minimap at the place for the player's allies, as if the player did it. The command goes from that player's computer to every computer, as if the player gave it, so the game stays the same everywhere. It acts on what the player has selected.", "", "make Player 1 ping the minimap at x 1024, y 512: the player's allies see a ping at the place."},
    {0, "act.qgc.pause", "Keyboard and mouse", "Pause as a player", "make {player} pause the game", "player|PlayerId|P1|", "", "", "advanced", 1, "", "QueueGameCommand_PauseGame", "Pauses the game, as if the player pressed the pause key (players can pause only a few times). The command goes from that player's computer to every computer, as if the player gave it, so the game stays the same everywhere. It acts on what the player has selected.", "", "make Player 1 pause the game: pause the game for all players as if Player 1 did it."},
