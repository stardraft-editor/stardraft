    {0, "act.unitprop", "Units", "Change a unit's property", "change {unit}'s {prop}: {mod} {value}", "unit|UnitRef|the unit|;prop|Property:CUnit|hp|;mod|VarModifier|SetTo|;value|ValueOf:prop|40|", "", "", "units", 2, "@prop CUnit", "CUnit", "Changes one property of one unit in the game. Examples are hit points, shields, energy, owner, timers such as stim or lockdown, and states such as burrowed or invincible. The Advanced section of the list has the raw properties. Values are the values that players see. For example, 40 hit points is 40.", "Some properties apply only to some units. For example, resources left applies to mineral fields and geysers, and hangar applies to carriers and reavers. If you set the owner, type or position of a unit directly, StarCraft does not do its usual bookkeeping. Use Give units and Move units.", "change the unit's hit points: set to 40: inside For each unit, set each hurt unit to 40 hit points."},
    {1, "cond.unitprop", "Units", "Check a unit's property", "{unit}'s {prop} is {cmp} {value}", "unit|UnitRef|the unit|;prop|Property:CUnit|hp|;cmp|NumberComparison|<=|;value|ValueOf:prop|20|", "", "", "units", 2, "@prop CUnit", "CUnit", "Compares one property of one unit in the game. Examples are hit points, shields, energy, owner, timers such as stim or lockdown, and states such as burrowed or invincible. The Advanced section of the list has the raw properties. Values are the values that players see. For example, 40 hit points is 40.", "The game keeps hit points, shields and energy in 1/256ths. Thus \"exactly 40\" can miss a unit at 40.5. Use at least or at most.", "the unit's hit points is at most 20: inside For each unit, find the units that are almost dead."},
    {0, "act.prop.unittype", "Game", "Change a unit type's stats", "change {type}'s {prop}: {mod} {value}", "type|UnitType|0|;prop|Property:TrgUnit|maxHp|;mod|VarModifier|SetTo|;value|ValueOf:prop|60|", "", "", "units", 2, "@prop TrgUnit", "TrgUnit", "Changes the values of a unit type from units.dat while the game runs. These are the same values that the Data workspace edits. Examples are hit points, armor, weapons, costs, sight, and flags such as Hero or Detector.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change Terran Marine's maximum hit points: set to 60: make all marines stronger in the second half of the game."},
    {1, "cond.prop.unittype", "Game", "Check a unit type's stats", "{type}'s {prop} is {cmp} {value}", "type|UnitType|0|;prop|Property:TrgUnit|maxHp|;cmp|NumberComparison|==|;value|ValueOf:prop|60|", "", "", "units", 2, "@prop TrgUnit", "TrgUnit", "Compares one value of a unit type from units.dat while the game runs. These are the same values that the Data workspace edits. Examples are hit points, armor, weapons, costs, sight, and flags such as Hero or Detector.", "It reads the current value in the game. This value includes changes from triggers.", "Terran Marine's maximum hit points is exactly 60: check that the marine upgrade of another trigger is active."},
    {0, "act.prop.weapon", "Game", "Change a weapon's stats", "change weapon {weapon}'s {prop}: {mod} {value}", "weapon|Dat:weapons|0|;prop|Property:Weapon|cooldown|;mod|VarModifier|SetTo|;value|ValueOf:prop|15|", "", "", "units", 2, "@prop Weapon", "Weapon", "Changes the values of a weapon from weapons.dat while the game runs. Examples are damage, cooldown, range, splash, and the targets that the weapon can attack.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change weapon Gauss Rifle's cooldown (frames): set to 10: marines attack faster after the player buys the upgrade."},
    {1, "cond.prop.weapon", "Game", "Check a weapon's stats", "weapon {weapon}'s {prop} is {cmp} {value}", "weapon|Dat:weapons|0|;prop|Property:Weapon|cooldown|;cmp|NumberComparison|==|;value|ValueOf:prop|15|", "", "", "units", 2, "@prop Weapon", "Weapon", "Compares one value of a weapon from weapons.dat while the game runs. Examples are damage, cooldown, range, splash, and the targets that the weapon can attack.", "It reads the current value in the game. This value includes changes from triggers.", "weapon Gauss Rifle's cooldown (frames) is exactly 15: check that the cooldown has the default value."},
    {0, "act.prop.upgrade", "Game", "Change an upgrade's stats", "change upgrade {upgrade}'s {prop}: {mod} {value}", "upgrade|Dat:upgrades|0|;prop|Property:Upgrade|maxLevel|;mod|VarModifier|SetTo|;value|ValueOf:prop|3|", "", "", "units", 2, "@prop Upgrade", "Upgrade", "Changes the values of an upgrade from upgrades.dat. Examples are the costs for each level, the research time, and the number of levels.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change upgrade Terran Infantry Armor's maximum level: set to 5: the players can research two more levels."},
    {1, "cond.prop.upgrade", "Game", "Check an upgrade's stats", "upgrade {upgrade}'s {prop} is {cmp} {value}", "upgrade|Dat:upgrades|0|;prop|Property:Upgrade|maxLevel|;cmp|NumberComparison|==|;value|ValueOf:prop|3|", "", "", "units", 2, "@prop Upgrade", "Upgrade", "Compares one value of an upgrade from upgrades.dat. Examples are the costs for each level, the research time, and the number of levels.", "It reads the current value in the game. This value includes changes from triggers.", "upgrade Terran Infantry Armor's maximum level is exactly 3: check that no trigger changed the number of levels."},
    {0, "act.prop.tech", "Game", "Change a technology's stats", "change technology {tech}'s {prop}: {mod} {value}", "tech|Dat:techdata|0|;prop|Property:Tech|energyCost|;mod|VarModifier|SetTo|;value|ValueOf:prop|50|", "", "", "units", 2, "@prop Tech", "Tech", "Changes the values of a technology from techdata.dat. Examples are the research costs, the research time, and the energy cost to use it.", "The change applies to all units of that kind for all players. It stays for the rest of the game, or until a trigger changes it back. StarCraft reads some values only when the map loads, for example graphics files. Changes to these values do not show on the screen.", "change technology Psionic Storm's energy cost: set to 100: the storm costs more energy in the hard mode."},
