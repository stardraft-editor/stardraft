    "        actions=[\n"
    "            cmpact << SetMemory(cmptrigger + 4, SetTo, 0)\n"
    "        ]\n"
    "    )\n"
    "    cmpact_ontrueaddr = cmpact + 20\n"
    "    PopTriggerScope()\n"
