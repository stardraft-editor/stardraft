    "@param.Key.Key\r\n"
    "]================================]\r\n"
    "function KeyParse(Key)\r\n"
    "\tindex = -1\r\n"
    "\tspkeys = {\"NUMPAD*\", \"NUMPAD+\", \"NUMPAD-\", \"NUMPAD.\", \"NUMPAD/\", \"*\", \"+\", \"-\", \".\", \"/\", \"=\", \",\", \"`\", \"[\", \"]\", \"\\\\\", \"'\"}\r\n"
    "\tfor k,v in pairs(spkeys) do\r\n"
    "\t\tif v == Key then\r\n"
    "\t\t\tindex = k\r\n"
    "\t\t\tbreak\r\n"
    "\t\tend\r\n"
    "\tend\r\n"
    "\r\n"
    "\tif index ~= -1 then\r\n"
    "\t\tKey = \"SP\" .. index\r\n"
    "\tend\r\n"
    "\r\n"
    "\treturn Key\r\n"
    "end\r\n"
    "\r\n"
