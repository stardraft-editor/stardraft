    " *\n"
    " * @param.epd.ko-KR\n"
    " * \xEC""\xA7""\x80""\xEC""\xA0""\x95""\xED""\x95""\xA0"" \xEC""\x9C""\xA0""\xEB""\x8B""\x9B""\xEC""\x9E""\x85""\xEB""\x8B""\x88""\xEB""\x8B""\xA4"".\n"
    " *\n"
