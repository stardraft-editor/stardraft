    " *\n"
    " * @param.range.ko-KR\n"
    " * \xEC""\x8A""\xA4""\xED""\x82""\xAC""\xEC""\x9D""\x84"" \xEA""\xB0""\x90""\xEC""\xA7""\x80""\xED""\x95""\xA0"" \xEB""\xB2""\x94""\xEC""\x9C""\x84""\xEC""\x9E""\x85""\xEB""\x8B""\x88""\xEB""\x8B""\xA4"".\n"
    " *\n"
    " * @param.targetLoc.ko-KR\n"
    " * \xEC""\x8A""\xA4""\xED""\x82""\xAC""\xEC""\x9D""\xB4"" \xED""\x83""\x80""\xEA""\xB2""\xA9""\xEB""\x90""\xA0"" \xEC""\x9C""\x84""\xEC""\xB9""\x98""\xEC""\x97""\x90"" \xEB""\xB6""\x80""\xEC""\xB0""\xA9""\xEB""\x90""\xA0"" \xEB""\xA1""\x9C""\xEC""\xBC""\x80""\xEC""\x9D""\xB4""\xEC""\x85""\x98""\xEC""\x9E""\x85""\xEB""\x8B""\x88""\xEB""\x8B""\xA4"".\n"
