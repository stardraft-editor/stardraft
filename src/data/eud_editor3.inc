    " * \xEB""\x8C""\x80""\xEC""\x83""\x81"" \xEC""\x9C""\xA0""\xEB""\x8B""\x9B""\xEC""\x9E""\x85""\xEB""\x8B""\x88""\xEB""\x8B""\xA4"".\n"
