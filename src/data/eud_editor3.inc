    "\t\t\t}else if(MemoryEPD(epd, Exactly, 16)){\n"
    "\t\t\t\tdotmargenta();\n"
    "\t\t\t}else if(MemoryEPD(epd, Exactly, 17)){\n"
    "\t\t\t\tdotdarkpink();\n"
    "\t\t\t}else if(MemoryEPD(epd, Exactly, 18)){\n"
    "\t\t\t\tdotlightgray();\n"
    "\t\t\t}else if(MemoryEPD(epd, Exactly, 19)){\n"
