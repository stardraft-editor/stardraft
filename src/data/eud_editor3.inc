    " *\n"
    " * @param.unitLoc.ko-KR\n"
    " * \xEC""\x8A""\xA4""\xED""\x82""\xAC""\xEC""\x9D""\x84"" \xEC""\x82""\xAC""\xEC""\x9A""\xA9""\xED""\x95""\x9C"" \xEC""\x9C""\xA0""\xEB""\x8B""\x9B""\xEC""\x97""\x90""\xEA""\xB2""\x8C"" \xEB""\xB6""\x80""\xEC""\xB0""\xA9""\xEB""\x90""\xA0"" \xEB""\xA1""\x9C""\xEC""\xBC""\x80""\xEC""\x9D""\xB4""\xEC""\x85""\x98""\xEC""\x9E""\x85""\xEB""\x8B""\x88""\xEB""\x8B""\xA4"".\n"
