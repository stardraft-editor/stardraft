<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>stardraft</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.stardraft-editor.stardraft</string>
    <key>CFBundleName</key>
    <string>StarDraft</string>
    <key>CFBundleDisplayName</key>
    <string>StarDraft 2</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleIconFile</key>
    <string>stardraft</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- StarCraft maps (.scm, .scx): StarDraft exports their types, so Finder opens them with StarDraft (an
         SDL_EVENT_DROP_FILE for each file). Their icons are made by the system from the app's icon (the badge) and the
         extension (the text); the Quick Look extensions in PlugIns (apps/quicklook) show each map's own picture. The type's
         name is translated in <language>.lproj/InfoPlist.strings (CMakeLists.txt makes them from res/lang/*.tsv). -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.stardraft-editor.map-scm</string>
            <key>UTTypeDescription</key>
            <string>StarCraft map</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeIcons</key>
            <dict>
                <key>UTTypeIconText</key>
                <string>scm</string>
                <key>UTTypeIconBadgeName</key>
                <string>stardraft</string>
            </dict>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>scm</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.github.stardraft-editor.map-scx</string>
            <key>UTTypeDescription</key>
            <string>StarCraft map</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeIcons</key>
            <dict>
                <key>UTTypeIconText</key>
                <string>scx</string>
                <key>UTTypeIconBadgeName</key>
                <string>stardraft</string>
            </dict>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>scx</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>StarCraft map</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>CFBundleTypeIconSystemGenerated</key>
            <true/>
            <key>LSItemContentTypes</key>
            <array>
                <string>io.github.stardraft-editor.map-scm</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>StarCraft map</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>CFBundleTypeIconSystemGenerated</key>
            <true/>
            <key>LSItemContentTypes</key>
            <array>
                <string>io.github.stardraft-editor.map-scx</string>
            </array>
        </dict>
        <!-- Projects (project.stardraft, .eds, a project's folder) and .chk files: they open when they are dropped on the
             Dock icon, as on the window; StarDraft is not the program that Finder opens them with (rank None). -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>StarDraft project</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>None</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>stardraft</string>
                <string>eds</string>
                <string>chk</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Folder</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>None</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.folder</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
