Type:8,False,False,False
act:RawCode
const locTable = EPD(0x58DC60);
const a0, a1, a2, a3 = dwread_epd(locTable + (target_location - 1) * 5), dwread_epd(locTable + (target_location - 1) * 5 + 1), dwread_epd(locTable + (target_location - 1) * 5 + 2), dwread_epd(locTable + (target_location - 1) * 5 + 3);
const b0, b1, b2, b3 = dwread_epd(locTable + (origin_location - 1) * 5), dwread_epd(locTable + (origin_location - 1) * 5 + 1), dwread_epd(locTable + (origin_location - 1) * 5 + 2), dwread_epd(locTable + (origin_location - 1) * 5 + 3);
const x_target, y_target = (a0 + a2) / 2, (a1 + a3) / 2;
const x_origin, y_origin = (b0 + b2) / 2, (b1 + b3) / 2;
const dy, dx = lengthdir(sqrt((x_target - x_origin)*(x_target - x_origin)+(y_target-y_origin)*(y_target-y_origin)),angle);
SetMemoryEPD(locTable + target_location * 5 + 0, Add, dx);
SetMemoryEPD(locTable + target_location * 5 + 2, Add, dx);
SetMemoryEPD(locTable + target_location * 5 + 1, Add, dy);
SetMemoryEPD(locTable + target_location * 5 + 3, Add, dy);
